# Loaded by the Python server. Exported variables take precedence.
# DeepSeek via the Nebius OpenAI-compatible API. Credentials stay server-side.
ADK_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
OPENAI_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1
OPENAI_API_KEY=replace-with-your-nebius-api-key

# Optional local store (use a separate file for tests).
# PENNY_DB=data/penny.sqlite

# Alternative: native Gemini on Vertex AI with Application Default Credentials.
# Run gcloud auth application-default login, then select:
# ADK_MODEL=gemini-3-flash-preview
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# PENNY_VERTEXAI=true
# PENNY_LOCATION=global

# Alternative: Gemini Developer API (complete tool arguments).
# ADK_MODEL=gemini-3-flash-preview
# PENNY_VERTEXAI=false
# GOOGLE_API_KEY=replace-with-your-google-api-key

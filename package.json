{
  "name": "penny",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dev:server": "uv run uvicorn server.main:app --host 127.0.0.1 --port 8000 --reload",
    "test:server": "uv run python -m unittest discover -s tests -v",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@copilotkit/react-core": "1.79.1",
    "@copilotkit/shared": "1.79.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "@ag-ui/client": "$@ag-ui/client",
    "@ag-ui/core": "1.0.3",
    "@ag-ui/encoder": "1.0.3",
    "@ag-ui/proto": "1.0.3"
  },
  "packageManager": "npm@11.19.1"
}
